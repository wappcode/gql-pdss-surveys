<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="GPDSurvey\Entities\SurveySectionItem" table="gpd_survey_section_item">
        <indexes>
            <index name="user_created_idx" columns="created"/>
            <index name="user_updated_idx" columns="updated"/>
        </indexes>

        <id name="id" type="string" column="id" length="27">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="PDSSUtilities\DoctrineUlidGenerator"/>
        </id>

        <field name="type" column="item_type" type="string" nullable="false"/>
        <field name="order" column="order_number" type="integer" nullable="false"/>
        <field name="hidden" column="hidden" type="boolean" nullable="false"/>
        <field name="created" column="created" type="datetimetz_immutable" nullable="false"/>
        <field name="updated" column="updated" type="datetimetz_immutable" nullable="false"/>

        <many-to-one field="conditions" target-entity="GPDSurvey\Entities\SurveyConfiguration" fetch="LAZY">
            <join-column name="condition_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>

        <one-to-one field="question" target-entity="GPDSurvey\Entities\SurveyQuestion" fetch="LAZY">
            <join-column name="question_id" referenced-column-name="id" nullable="true"/>
        </one-to-one>

        <one-to-one field="content" target-entity="GPDSurvey\Entities\SurveyContent" fetch="LAZY">
            <join-column name="content_id" referenced-column-name="id" nullable="true"/>
        </one-to-one>

        <many-to-one field="section" target-entity="GPDSurvey\Entities\SurveySection" inversed-by="items" fetch="LAZY">
            <join-column name="section_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
