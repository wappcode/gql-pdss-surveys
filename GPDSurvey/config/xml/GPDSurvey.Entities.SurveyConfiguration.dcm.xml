<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="GPDSurvey\Entities\SurveyConfiguration" table="gpd_survey_configuration">
        <indexes>
            <index name="user_created_idx" columns="created"/>
            <index name="user_updated_idx" columns="updated"/>
        </indexes>

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="value" column="config_value" type="json" nullable="false"/>
        <field name="type" column="config_type" type="string" nullable="false"/>
        <field name="created" column="created" type="datetimetz_immutable" nullable="false"/>
        <field name="updated" column="updated" type="datetimetz_immutable" nullable="false"/>
    </entity>
</doctrine-mapping>
