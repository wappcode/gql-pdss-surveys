<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="GPDSurvey\Entities\SurveyAnswerSession" table="gpd_survey_answer_session">
        <indexes>
            <index name="user_created_idx" columns="created"/>
            <index name="user_updated_idx" columns="updated"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="username" columns="target_audience_id,username"/>
        </unique-constraints>

        <id name="id" type="string" column="id" length="27">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="PDSSUtilities\DoctrineUlidGenerator"/>
        </id>

        <field name="name" column="name" type="string" length="500" nullable="true"/>
        <field name="username" column="username" type="string" length="500" nullable="true"/>
        <field name="password" column="session_password" type="string" length="500" nullable="true"/>
        <field name="ownerCode" column="owner_code" type="string" length="500" nullable="true"/>
        <field name="score" column="score" type="decimal" precision="10" scale="4" nullable="true"/>
        <field name="completed" column="completed" type="boolean" nullable="false"/>
        <field name="scorePercent" column="score_percent" type="decimal" precision="8" scale="4" nullable="true"/>
        <field name="created" column="created" type="datetimetz_immutable" nullable="false"/>
        <field name="updated" column="updated" type="datetimetz_immutable" nullable="false"/>

        <one-to-many field="answers" target-entity="GPDSurvey\Entities\SurveyAnswer" mapped-by="session"/>

        <many-to-one field="targetAudience" target-entity="GPDSurvey\Entities\SurveyTargetAudience" fetch="LAZY">
            <join-column name="target_audience_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <many-to-one field="survey" target-entity="GPDSurvey\Entities\Survey" fetch="LAZY">
            <join-column name="survey_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
