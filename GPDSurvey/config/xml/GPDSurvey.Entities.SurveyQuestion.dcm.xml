<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="GPDSurvey\Entities\SurveyQuestion" table="gpd_survey_question">
        <indexes>
            <index name="user_created_idx" columns="created"/>
            <index name="user_updated_idx" columns="updated"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="question_survey_code" columns="survey_id,code"/>
        </unique-constraints>

        <id name="id" type="string" column="id" length="27">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="PDSSUtilities\DoctrineUlidGenerator"/>
        </id>

        <field name="title" column="title" type="string" length="5000" nullable="false"/>
        <field name="code" column="code" type="string" nullable="false"/>
        <field name="type" column="question_type" type="string" nullable="false"/>
        <field name="required" column="required" type="boolean" nullable="false"/>
        <field name="other" column="other" type="boolean" nullable="false"/>
        <field name="score" column="score" type="decimal" precision="10" scale="4" nullable="true"/>
        <field name="created" column="created" type="datetimetz_immutable" nullable="false"/>
        <field name="updated" column="updated" type="datetimetz_immutable" nullable="false"/>

        <many-to-one field="hint" target-entity="GPDSurvey\Entities\SurveyContent" fetch="LAZY">
            <join-column name="question_hint" referenced-column-name="id" nullable="true"/>
        </many-to-one>

        <one-to-many field="options" target-entity="GPDSurvey\Entities\SurveyQuestionOption" mapped-by="question"/>

        <many-to-one field="content" target-entity="GPDSurvey\Entities\SurveyContent" fetch="LAZY">
            <join-column name="content_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>

        <many-to-one field="presentation" target-entity="GPDSurvey\Entities\SurveyConfiguration" fetch="LAZY">
            <join-column name="presentation_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>

        <many-to-one field="validators" target-entity="GPDSurvey\Entities\SurveyConfiguration" fetch="LAZY">
            <join-column name="validators_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>

        <one-to-one field="answerScore" target-entity="GPDSurvey\Entities\SurveyConfiguration" fetch="LAZY">
            <join-column name="answer_score_id" referenced-column-name="id" nullable="true"/>
        </one-to-one>

        <many-to-one field="survey" target-entity="GPDSurvey\Entities\Survey" inversed-by="questions" fetch="LAZY">
            <join-column name="survey_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
