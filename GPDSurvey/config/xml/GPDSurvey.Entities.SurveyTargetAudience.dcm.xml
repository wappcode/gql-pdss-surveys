<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="GPDSurvey\Entities\SurveyTargetAudience" table="gpd_survey_target_audience">
        <indexes>
            <index name="user_created_idx" columns="created"/>
            <index name="user_updated_idx" columns="updated"/>
        </indexes>

        <id name="id" type="string" column="id" length="27">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="PDSSUtilities\DoctrineUlidGenerator"/>
        </id>

        <field name="title" column="title" type="string" nullable="false"/>
        <field name="starts" column="starts" type="datetimetz_immutable" nullable="true"/>
        <field name="ends" column="ends" type="datetimetz_immutable" nullable="true"/>
        <field name="attempts" column="attempts" type="integer" nullable="true"/>
        <field name="password" column="audience_password" type="string" length="255" nullable="true"/>
        <field name="created" column="created" type="datetimetz_immutable" nullable="false"/>
        <field name="updated" column="updated" type="datetimetz_immutable" nullable="false"/>

        <many-to-one field="welcome" target-entity="GPDSurvey\Entities\SurveyContent" fetch="LAZY">
            <join-column name="welcome_content_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>

        <many-to-one field="farewell" target-entity="GPDSurvey\Entities\SurveyContent" fetch="LAZY">
            <join-column name="farewell_content_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>

        <many-to-one field="survey" target-entity="GPDSurvey\Entities\Survey" inversed-by="targetAudiences" fetch="LAZY">
            <join-column name="survey_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <many-to-one field="presentation" target-entity="GPDSurvey\Entities\SurveyConfiguration" fetch="LAZY">
            <join-column name="presentation_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
